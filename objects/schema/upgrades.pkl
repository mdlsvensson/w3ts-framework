module wc3.schema.upgrades

import "types.pkl" as types
import "common.pkl" as common
import "generated/upgrades_props.pkl" as generated

/// Warcraft III research upgrade.
/// Inherits all 37 upgrade properties from `GeneratedUpgradeProps`.
open class Upgrade extends generated.GeneratedUpgradeProps {
  id: types.UpgradeId
  base: String(length == 4 && matches(Regex("^[A-Za-z0-9]{4}$")))
}
